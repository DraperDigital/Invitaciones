# Example environment variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps Embed API Key (restrict to your domain in Google Cloud Console)
VITE_GOOGLE_MAPS_KEY=your-google-maps-key-here

# Optional: Uncomment if you need these
# VITE_APP_URL=http://localhost:5173
# VITE_WHATSAPP_NUMBER=+521234567890

# Analytics (optional — leave empty to disable)
# Microsoft Clarity project ID (https://clarity.microsoft.com)
VITE_CLARITY_ID=
# Google Analytics 4 measurement ID, format: G-XXXXXXXXXX
VITE_GA4_ID=
