<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Return real 404 for ai-catalog.json and missing json, xml, txt files
  RewriteCond %{REQUEST_URI} ^/(\.well-known/)?ai-catalog\.json$ [NC,OR]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} \.(json|xml|txt)$ [NC]
  RewriteRule ^ - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# ── Browser Caching & Performance ───────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Default fallback: 30 days
  ExpiresDefault "access plus 30 days"

  # HTML: Never cache SPA shell
  ExpiresByType text/html "access plus 0 seconds"

  # Hashed / Static Assets
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  # 1. HTML files: always revalidate so users receive new deploys instantly
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # 2. Hashed build assets in /assets/ (JS, CSS, chunked media): 1 year + immutable
  <FilesMatch "^.*-[a-zA-Z0-9_-]{8,}\.(js|css|woff2?|png|jpe?g|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Apply to any file under /assets/ directory
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # 3. Unhashed media and public assets: 30 days (2592000 seconds)
  <FilesMatch "\.(ico|jpe?g|png|gif|svg|webp|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
